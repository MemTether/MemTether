{
  "name": "memtether",
  "display_name": "MemTether",
  "description": "Cross-client AI memory hub. SQLite + FTS5 + Bi-temporal + Source Attribution. Local-first, no cloud. 23 client adapters.",
  "version": "0.1.0a15",
  "mcp_version": "1.0",
  "server": {
    "command": "python",
    "args": [
      "-m",
      "mcp_server"
    ],
    "env": {
      "MEM_DB": "~/.memtether/memory.db"
    }
  },
  "tools": [
    {
      "name": "search_memory",
      "description": "Search the shared memory hub"
    },
    {
      "name": "add_memories",
      "description": "Write new memories to the hub"
    },
    {
      "name": "list_memories",
      "description": "List recent memories"
    }
  ],
  "repository": "https://github.com/MemTether/MemTether",
  "license": "Apache-2.0",
  "keywords": [
    "agent-memory",
    "mcp",
    "sqlite",
    "fts5",
    "bi-temporal",
    "cross-client",
    "local-first"
  ],
  "homepage": "https://github.com/MemTether/MemTether",
  "pypi": "https://pypi.org/project/memtether/"
}