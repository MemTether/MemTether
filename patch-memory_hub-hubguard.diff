+        import re as _hg_re
+        _HG_TAG_RE = _hg_re.compile(r'^- \[\d{4}-\d{2}-\d{2}\|[^\]·]+·[^\]·]+\]')
+    return sum(1 for _l in (text or '').split('\n') if _HG_TAG_RE.match(_l))
